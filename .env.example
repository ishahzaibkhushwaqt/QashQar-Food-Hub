PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# MONGODB_URI is optional; if omitted or unreachable, QFH automatically starts
# an in-process MongoDB instance (great for local dev / hackathon demos)
MONGODB_URI=

NEXT_PUBLIC_APP_NAME="Qashqar Food Hub (QFH)"
NEXT_PUBLIC_APP_TAGLINE="Qashqar Valley's Premier Food Ordering & Delivery Network"
NEXT_PUBLIC_SUPPORT_PHONE="03426522787"
NEXT_PUBLIC_RIDER_PHONE="03426522787"

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Groq free API key — sign up at https://console.groq.com and create a key.
# Used by /api/ai/qfh-gpt to power real conversational AI responses in the
# QFH GPT chat widget (model: llama-3.3-70b-versatile).
# Without this key the endpoint gracefully falls back to rule-based replies.
GROQ_API_KEY=your_groq_api_key_here
