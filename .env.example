PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# MONGODB_URI is optional; if omitted or unreachable, QFH automatically starts
# an in-process MongoDB instance (great for local dev / hackathon demos)
MONGODB_URI=

NEXT_PUBLIC_APP_NAME="Qashqar Food Hub (QFH)"
NEXT_PUBLIC_APP_TAGLINE="Qashqar Valley's Premier Food Ordering & Delivery Network"
NEXT_PUBLIC_SUPPORT_PHONE="03426522787"
NEXT_PUBLIC_RIDER_PHONE="03426522787"

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
